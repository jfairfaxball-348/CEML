{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "digest",
    "run_digest",
    "run_id",
    "snapshot_digest",
    "base_kind",
    "base_B",
    "batch_start",
    "batch_end",
    "predecessor_digest",
    "ruleset_id",
    "table_digest",
    "native_build_digest",
    "generation",
    "previous_checkpoint_digest",
    "next_n",
    "transcript_digest",
    "counts",
    "explicit_t_steps",
    "explicit_odd_steps",
    "explicit_standard_steps",
    "explicit_attempts",
    "pending"
  ],
  "properties": {
    "schema": {
      "const": "CEML-FRONTIER-CKPT-1"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_kind": {
      "enum": [
        "published",
        "operational"
      ]
    },
    "base_B": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 8192
    },
    "batch_start": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 8192
    },
    "batch_end": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 8192
    },
    "predecessor_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ruleset_id": {
      "const": "E2-Q4-P3-M9-S2K4-03-v1"
    },
    "table_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "native_build_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 8192
    },
    "previous_checkpoint_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_n": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 8192
    },
    "transcript_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_count",
        "e2_count",
        "q4_count",
        "p3_count",
        "m9_count",
        "s2_count",
        "explicit_count",
        "unresolved_count"
      ],
      "properties": {
        "base_count": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 8192
        },
        "e2_count": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 8192
        },
        "q4_count": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 8192
        },
        "p3_count": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 8192
        },
        "m9_count": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 8192
        },
        "s2_count": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 8192
        },
        "explicit_count": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 8192
        },
        "unresolved_count": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 8192
        }
      }
    },
    "explicit_t_steps": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 8192
    },
    "explicit_odd_steps": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 8192
    },
    "explicit_standard_steps": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 8192
    },
    "explicit_attempts": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 8192
    },
    "pending": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n",
            "reason",
            "attempted_steps",
            "last_value"
          ],
          "properties": {
            "n": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 8192
            },
            "reason": {
              "enum": [
                "step_budget",
                "total_budget",
                "resource_refusal",
                "native_failure",
                "oracle_mismatch"
              ]
            },
            "attempted_steps": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 8192
            },
            "last_value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 8192
            }
          }
        }
      ]
    }
  }
}
