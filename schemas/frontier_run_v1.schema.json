{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "run1_authority_id",
    "snapshot_digest",
    "base_kind",
    "base_B",
    "accepted_assumption_ack",
    "batch_start",
    "batch_end",
    "predecessor_digest",
    "ruleset_id",
    "table_digest",
    "native_build_digest",
    "map_id",
    "max_t_per_explicit",
    "max_total_t"
  ],
  "properties": {
    "schema": {
      "const": "CEML-FRONTIER-1-RUN"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
    },
    "run1_authority_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_kind": {
      "enum": [
        "published",
        "operational"
      ]
    },
    "base_B": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 8192
    },
    "accepted_assumption_ack": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "batch_start": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 8192
    },
    "batch_end": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 8192
    },
    "predecessor_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ruleset_id": {
      "const": "E2-Q4-P3-M9-S2K4-03-v1"
    },
    "table_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "native_build_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "map_id": {
      "const": "T-shortened-v1"
    },
    "max_t_per_explicit": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 8192
    },
    "max_total_t": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 8192
    }
  }
}
