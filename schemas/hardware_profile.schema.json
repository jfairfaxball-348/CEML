{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jfairfaxball-348/CEML/schemas/hardware_profile.schema.json",
  "title": "CEML Sanitized Local Machine/Build Profile",
  "description": "I1-frozen sanitized profile schema. Populated only by C1; prohibited stable identifiers must never appear.",
  "x-ceml-status": "frozen-engineering-i1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment",
    "schema_version",
    "machine_profile_digest",
    "source_commit",
    "build_digest",
    "hardware_report_digest",
    "benchmark_summary_digest",
    "engineering_decision_log_digest",
    "system",
    "cpu",
    "memory",
    "checkpoint_storage",
    "toolchain",
    "dependencies",
    "engineering_choices",
    "resource_limits",
    "unavailable_constraints",
    "evidence_refs",
    "privacy_attestation"
  ],
  "properties": {
    "experiment": {
      "const": "CEML"
    },
    "schema_version": {
      "const": "CEML-LOCAL-MACHINE-PROFILE-1"
    },
    "machine_profile_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "build_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hardware_report_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "benchmark_summary_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "engineering_decision_log_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_family",
        "os_release",
        "kernel_release",
        "architecture",
        "abi",
        "virtualization"
      ],
      "properties": {
        "os_family": {
          "type": "string",
          "minLength": 1
        },
        "os_release": {
          "type": "string",
          "minLength": 1
        },
        "kernel_release": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "abi": {
          "type": "string",
          "minLength": 1
        },
        "virtualization": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "cpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor",
        "model",
        "physical_cores",
        "logical_threads",
        "instruction_features",
        "cache_summary"
      ],
      "properties": {
        "vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "physical_cores": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        },
        "logical_threads": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        },
        "instruction_features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "cache_summary": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "kind",
              "bytes"
            ],
            "properties": {
              "level": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "bytes": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installed_bytes",
        "available_bytes_at_audit",
        "swap_capacity_bytes",
        "page_size_bytes"
      ],
      "properties": {
        "installed_bytes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        },
        "available_bytes_at_audit": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        },
        "swap_capacity_bytes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        },
        "page_size_bytes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        }
      }
    },
    "checkpoint_storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem_class",
        "local_or_remote",
        "durability_supported",
        "durability_decision_id",
        "strategy"
      ],
      "properties": {
        "filesystem_class": {
          "type": "string",
          "minLength": 1
        },
        "local_or_remote": {
          "enum": [
            "local",
            "remote",
            "unknown"
          ]
        },
        "durability_supported": {
          "type": "boolean"
        },
        "durability_decision_id": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language_family",
        "compiler",
        "compiler_version",
        "linker",
        "linker_version",
        "target_triple",
        "abi",
        "flags",
        "native_tuning",
        "non_portable"
      ],
      "properties": {
        "language_family": {
          "type": "string",
          "minLength": 1
        },
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "compiler_version": {
          "type": "string",
          "minLength": 1
        },
        "linker": {
          "type": "string",
          "minLength": 1
        },
        "linker_version": {
          "type": "string",
          "minLength": 1
        },
        "target_triple": {
          "type": "string",
          "minLength": 1
        },
        "abi": {
          "type": "string",
          "minLength": 1
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "native_tuning": {
          "type": "boolean"
        },
        "non_portable": {
          "type": "boolean"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "source_channel",
          "artifact_digest",
          "linkage",
          "features"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "source_channel": {
            "type": "string",
            "minLength": 1
          },
          "artifact_digest": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            ]
          },
          "linkage": {
            "type": "string",
            "minLength": 1
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "engineering_choices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_route",
        "state_representation",
        "small_block_width",
        "hierarchical_divisor",
        "hierarchical_k_cap",
        "allocation_strategy",
        "parallelism_route",
        "thread_count",
        "terminal_handoff",
        "audit_mode",
        "checkpoint_strategy"
      ],
      "properties": {
        "backend_route": {
          "type": "string",
          "minLength": 1
        },
        "state_representation": {
          "type": "string",
          "minLength": 1
        },
        "small_block_width": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          ]
        },
        "hierarchical_divisor": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          ]
        },
        "hierarchical_k_cap": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          ]
        },
        "allocation_strategy": {
          "type": "string",
          "minLength": 1
        },
        "parallelism_route": {
          "type": "string",
          "minLength": 1
        },
        "thread_count": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "terminal_handoff": {
          "type": "string",
          "minLength": 1
        },
        "audit_mode": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_strategy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_available_memory_bytes",
        "maximum_process_memory_bytes",
        "minimum_free_storage_bytes",
        "swap_pressure_rule",
        "maximum_processes",
        "maximum_threads",
        "thermal_stop_rule",
        "maximum_case_seconds",
        "power_sleep_precondition"
      ],
      "properties": {
        "minimum_available_memory_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "maximum_process_memory_bytes": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "minimum_free_storage_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "swap_pressure_rule": {
          "type": "string",
          "minLength": 1
        },
        "maximum_processes": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "maximum_threads": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "thermal_stop_rule": {
          "type": "string",
          "minLength": 1
        },
        "maximum_case_seconds": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "power_sleep_precondition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unavailable_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "privacy_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensitive_identifiers_excluded",
        "scan_passed",
        "scan_artifact_digest"
      ],
      "properties": {
        "sensitive_identifiers_excluded": {
          "const": true
        },
        "scan_passed": {
          "const": true
        },
        "scan_artifact_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
