# Local-only CEML state
local/*
!local/README.md
local_reports/
.ceml/
checkpoints/
checkpoint-*
*.cemlcp
*.checkpoint

# Giant/intermediate arithmetic artifacts
*.giant
*.bigint
*.tmpstate
tmp/
scratch/

# Runtime logs and profiles not explicitly curated
logs/
*.log
perf.data*
*.prof
*.trace

# Build outputs
target/
build/
dist/
out/
CMakeFiles/
CMakeCache.txt
cmake-build-*/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Secrets / environment
.env
.env.*
*.pem
*.key
secrets/

# Large compressed/local exports
*.tar
*.tar.gz
*.tgz
*.zip
*.zst
*.xz
