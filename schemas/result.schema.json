{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jfairfaxball-348/CEML/schemas/result.schema.json",
  "title": "CEML Result",
  "description": "R3-frozen deterministic scientific result record for CEML-SCI-1.",
  "x-ceml-status": "frozen-scientific-r3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment",
    "schema_version",
    "result_digest",
    "run_id",
    "manifest_digest",
    "protocol_version",
    "protocol_commit",
    "rung",
    "generator_version",
    "seed_commitment",
    "start_digest",
    "engine_commit",
    "build_digest",
    "machine_profile_digest",
    "validation_evidence_digest",
    "map_semantics_version",
    "status",
    "status_detail",
    "shortcut_steps",
    "odd_steps",
    "standard_steps",
    "final_value",
    "final_checkpoint_digest"
  ],
  "properties": {
    "experiment": {
      "const": "CEML"
    },
    "schema_version": {
      "const": "CEML-RESULT-1"
    },
    "result_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "protocol_version": {
      "const": "CEML-SCI-1"
    },
    "protocol_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "rung": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_version",
        "decimal_digits",
        "rung_index"
      ],
      "properties": {
        "definition_version": {
          "const": "decimal-digits-v1"
        },
        "decimal_digits": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "rung_index": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "generator_version": {
      "const": "ceml-start-v1"
    },
    "seed_commitment": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "start_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "engine_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "build_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "machine_profile_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validation_evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "map_semantics_version": {
      "const": "CEML-COLLATZ-1"
    },
    "status": {
      "enum": [
        "completed",
        "frozen_anomaly",
        "operator_abort",
        "validation_failure",
        "resource_stop",
        "integrity_failure",
        "reproducibility_failure",
        "provenance_failure",
        "unexpected_termination"
      ]
    },
    "status_detail": {
      "type": [
        "string",
        "null"
      ]
    },
    "shortcut_steps": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "odd_steps": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "standard_steps": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "final_value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      ]
    },
    "final_checkpoint_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "final_value": {
            "const": "1"
          },
          "status_detail": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "completed"
            }
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "status_detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
