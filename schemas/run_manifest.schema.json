{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jfairfaxball-348/CEML/schemas/run_manifest.schema.json",
  "title": "CEML Run Manifest",
  "description": "Bootstrap draft. Scientific semantics freeze in R3/I1.",
  "x-ceml-status": "bootstrap-draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment",
    "schema_version",
    "run_id",
    "protocol_version",
    "protocol_commit",
    "rung",
    "generator",
    "map_convention",
    "exact_arithmetic",
    "authorization_gate"
  ],
  "properties": {
    "experiment": {
      "const": "CEML"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "protocol_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "machine_profile_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "machine_profile_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "engine_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "build_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "rung": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "value"
      ],
      "properties": {
        "unit": {
          "enum": [
            "decimal_digits",
            "bit_length",
            "unfrozen"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "derivation",
        "seed_reference",
        "start_digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "derivation": {
          "type": "string"
        },
        "seed_reference": {
          "type": "string",
          "description": "Seed or commitment reference according to frozen policy."
        },
        "start_digest": {
          "type": "string"
        },
        "start_bits": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+$"
        },
        "start_decimal_digits": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+$"
        }
      }
    },
    "map_convention": {
      "type": "string",
      "minLength": 1
    },
    "exact_arithmetic": {
      "const": true
    },
    "checkpoint_format_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "authorization_gate": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
