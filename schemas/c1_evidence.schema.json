{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jfairfaxball-348/CEML/schemas/c1_evidence.schema.json",
  "title": "CEML C1 Engineering Evidence",
  "description": "I1-frozen envelope schema for sanitized C1 hardware, calibration, decision, bundle, summary and build artifacts.",
  "x-ceml-status": "frozen-engineering-i1",
  "oneOf": [
    {
      "$ref": "#/$defs/hardware_report"
    },
    {
      "$ref": "#/$defs/calibration_record"
    },
    {
      "$ref": "#/$defs/benchmark_summary"
    },
    {
      "$ref": "#/$defs/decision_log"
    },
    {
      "$ref": "#/$defs/bundle_index"
    },
    {
      "$ref": "#/$defs/build_manifest"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$"
    },
    "observed_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_class",
        "record_id",
        "category",
        "fact_name",
        "value",
        "source_adapter",
        "source_method",
        "audit_run_id",
        "source_state_kind",
        "uncertainty",
        "sanitization",
        "observed_at"
      ],
      "properties": {
        "record_class": {
          "const": "OBSERVED_FACT"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "fact_name": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "source_adapter": {
          "type": "string",
          "minLength": 1
        },
        "source_method": {
          "type": "string",
          "minLength": 1
        },
        "audit_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$"
        },
        "source_state_kind": {
          "enum": [
            "static_capability",
            "active_configuration",
            "momentary_state"
          ]
        },
        "uncertainty": {
          "type": [
            "string",
            "null"
          ]
        },
        "sanitization": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_class",
        "record_id",
        "category",
        "requested_item",
        "attempted_method",
        "reason",
        "downstream_effects"
      ],
      "properties": {
        "record_class": {
          "const": "UNAVAILABLE_OR_UNSUPPORTED"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "requested_item": {
          "type": "string",
          "minLength": 1
        },
        "attempted_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "downstream_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "hardware_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment",
        "schema_version",
        "artifact_digest",
        "audit_run_id",
        "generated_at",
        "records",
        "privacy_scan_passed"
      ],
      "properties": {
        "experiment": {
          "const": "CEML"
        },
        "schema_version": {
          "const": "CEML-HARDWARE-REPORT-1"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "audit_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "records": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/observed_fact"
              },
              {
                "$ref": "#/$defs/unavailable"
              }
            ]
          }
        },
        "privacy_scan_passed": {
          "const": true
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_routes",
        "activated_counts",
        "fallback_count",
        "route_evidence_digest"
      ],
      "properties": {
        "requested_routes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "activated_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        },
        "fallback_count": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "route_evidence_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "calibration_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment",
        "schema_version",
        "artifact_digest",
        "record_class",
        "record_id",
        "suite_version",
        "case_id",
        "input_id",
        "input_digest",
        "candidate_id",
        "build_id",
        "executable_digest",
        "build_context",
        "wall_clock_method",
        "cpu_time_method",
        "peak_rss_method",
        "artifact_digests",
        "repeat_index",
        "warmup",
        "measured",
        "activation",
        "wall_time_ns",
        "cpu_time_ns",
        "peak_rss_bytes",
        "scratch_bytes",
        "correctness_state_digest",
        "reference_state_digest",
        "correctness_agreement",
        "valid",
        "invalid_reason",
        "abort_code"
      ],
      "properties": {
        "experiment": {
          "const": "CEML"
        },
        "schema_version": {
          "const": "CEML-CALIBRATION-RECORD-1"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "record_class": {
          "const": "CALIBRATION_MEASUREMENT"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$"
        },
        "suite_version": {
          "const": "CEML-CAL-1"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$"
        },
        "input_digest": {
          "$ref": "#/$defs/digest"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "build_id": {
          "type": "string",
          "minLength": 1
        },
        "repeat_index": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "warmup": {
          "type": "boolean"
        },
        "measured": {
          "type": "boolean"
        },
        "activation": {
          "$ref": "#/$defs/activation"
        },
        "wall_time_ns": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        },
        "cpu_time_ns": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        },
        "peak_rss_bytes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        },
        "live_bytes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        },
        "swap_observation": {
          "type": [
            "string",
            "null"
          ]
        },
        "scratch_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "thermal_observation": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkpoint_metrics": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "serialized_bytes",
                "serialization_time_ns",
                "write_time_ns",
                "durable_flush_time_ns",
                "promotion_time_ns",
                "directory_sync_time_ns"
              ],
              "properties": {
                "serialized_bytes": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "serialization_time_ns": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "write_time_ns": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "durable_flush_time_ns": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "promotion_time_ns": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "directory_sync_time_ns": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              }
            }
          ]
        },
        "correctness_state_digest": {
          "$ref": "#/$defs/digest"
        },
        "reference_state_digest": {
          "$ref": "#/$defs/digest"
        },
        "correctness_agreement": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        },
        "invalid_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "abort_code": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "C1_PREFLIGHT_REFUSAL",
                "C1_RESOURCE_ABORT",
                "C1_CORRECTNESS_INVALID",
                "C1_ROUTE_INVALID",
                "C1_MEASUREMENT_INVALID",
                "C1_ENVIRONMENT_INVALID"
              ]
            }
          ]
        },
        "executable_digest": {
          "$ref": "#/$defs/digest"
        },
        "build_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_commit",
            "target_triple",
            "abi",
            "toolchains",
            "flags",
            "dependencies",
            "enabled_features",
            "process_count",
            "thread_count",
            "affinity"
          ],
          "properties": {
            "source_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            },
            "target_triple": {
              "type": "string",
              "minLength": 1
            },
            "abi": {
              "type": "string",
              "minLength": 1
            },
            "toolchains": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "version"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "flags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "version",
                  "linkage",
                  "features"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "linkage": {
                    "type": "string",
                    "minLength": 1
                  },
                  "features": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  }
                }
              }
            },
            "enabled_features": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "process_count": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "thread_count": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "affinity": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "wall_clock_method": {
          "type": "string",
          "minLength": 1
        },
        "cpu_time_method": {
          "type": "string",
          "minLength": 1
        },
        "peak_rss_method": {
          "type": "string",
          "minLength": 1
        },
        "frequency_observation": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_digests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digest"
          },
          "uniqueItems": true
        },
        "input_id": {
          "$ref": "#/$defs/record_id"
        }
      }
    },
    "case_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "candidate_id",
        "valid_repeats",
        "invalid_repeats",
        "median_wall_time_ns",
        "minimum_wall_time_ns",
        "maximum_wall_time_ns",
        "mad_wall_time_ns",
        "peak_rss_bytes",
        "correctness_all",
        "route_activation_proved",
        "decision_ids"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "valid_repeats": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "invalid_repeats": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "median_wall_time_ns": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        },
        "minimum_wall_time_ns": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        },
        "maximum_wall_time_ns": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        },
        "mad_wall_time_ns": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        },
        "peak_rss_bytes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        },
        "correctness_all": {
          "type": "boolean"
        },
        "route_activation_proved": {
          "type": "boolean"
        },
        "decision_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$"
          },
          "uniqueItems": true
        }
      }
    },
    "benchmark_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment",
        "schema_version",
        "artifact_digest",
        "suite_version",
        "hardware_report_digest",
        "benchmark_bundle_index_digest",
        "cases"
      ],
      "properties": {
        "experiment": {
          "const": "CEML"
        },
        "schema_version": {
          "const": "CEML-BENCHMARK-SUMMARY-1"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "suite_version": {
          "const": "CEML-CAL-1"
        },
        "hardware_report_digest": {
          "$ref": "#/$defs/digest"
        },
        "benchmark_bundle_index_digest": {
          "$ref": "#/$defs/digest"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case_summary"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_class",
        "decision_id",
        "question",
        "candidates_considered",
        "evidence_record_ids",
        "eliminated",
        "selection",
        "decision_rule",
        "rationale",
        "limitations",
        "binds_profile"
      ],
      "properties": {
        "record_class": {
          "const": "ENGINEERING_DECISION"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "candidates_considered": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_record_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$"
          },
          "uniqueItems": true
        },
        "eliminated": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate",
              "reason"
            ],
            "properties": {
              "candidate": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "selection": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "decision_rule": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "binds_profile": {
          "type": "boolean"
        }
      }
    },
    "decision_log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment",
        "schema_version",
        "artifact_digest",
        "decisions"
      ],
      "properties": {
        "experiment": {
          "const": "CEML"
        },
        "schema_version": {
          "const": "CEML-ENGINEERING-DECISIONS-1"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "bundle_digest",
        "logical_locator",
        "member_count",
        "retained_local",
        "decision_ids"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$"
        },
        "bundle_digest": {
          "$ref": "#/$defs/digest"
        },
        "logical_locator": {
          "type": "string",
          "pattern": "^local/c1/benchmark_bundles/[A-Za-z0-9._/-]+/$"
        },
        "member_count": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "retained_local": {
          "type": "boolean"
        },
        "decision_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$"
          },
          "uniqueItems": true
        }
      }
    },
    "bundle_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment",
        "schema_version",
        "artifact_digest",
        "bundles"
      ],
      "properties": {
        "experiment": {
          "const": "CEML"
        },
        "schema_version": {
          "const": "CEML-BENCHMARK-BUNDLES-1"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "bundles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bundle"
          }
        }
      }
    },
    "build_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment",
        "schema_version",
        "build_digest",
        "source_commit",
        "target_triple",
        "abi",
        "toolchains",
        "flags",
        "native_tuning",
        "non_portable",
        "dependencies",
        "enabled_routes",
        "lock_artifacts",
        "build_artifacts",
        "offline_rebuild_recipe"
      ],
      "properties": {
        "experiment": {
          "const": "CEML"
        },
        "schema_version": {
          "const": "CEML-BUILD-MANIFEST-1"
        },
        "build_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "target_triple": {
          "type": "string",
          "minLength": 1
        },
        "abi": {
          "type": "string",
          "minLength": 1
        },
        "toolchains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "native_tuning": {
          "type": "boolean"
        },
        "non_portable": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "source_channel",
              "artifact_digest",
              "build_options",
              "linkage",
              "features"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "source_channel": {
                "type": "string",
                "minLength": 1
              },
              "artifact_digest": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/digest"
                  }
                ]
              },
              "build_options": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "linkage": {
                "type": "string",
                "minLength": 1
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          }
        },
        "enabled_routes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "lock_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "logical_path",
              "sha3_256"
            ],
            "properties": {
              "logical_path": {
                "type": "string",
                "minLength": 1
              },
              "sha3_256": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "build_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "logical_name",
              "sha3_256",
              "bytes"
            ],
            "properties": {
              "logical_name": {
                "type": "string",
                "minLength": 1
              },
              "sha3_256": {
                "$ref": "#/$defs/digest"
              },
              "bytes": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            }
          }
        },
        "offline_rebuild_recipe": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
