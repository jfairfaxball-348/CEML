{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jfairfaxball-348/CEML/schemas/run_manifest.schema.json",
  "title": "CEML Run Manifest",
  "description": "R3-frozen scientific run manifest for CEML-SCI-1.",
  "x-ceml-status": "frozen-scientific-r3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment",
    "schema_version",
    "manifest_digest",
    "run_id",
    "protocol_version",
    "protocol_commit",
    "rung",
    "generator",
    "map_semantics_version",
    "exact_arithmetic",
    "engine_commit",
    "build_digest",
    "machine_profile_digest",
    "validation_evidence_digest",
    "checkpoint_format_version",
    "authorization_gate",
    "created_at"
  ],
  "properties": {
    "experiment": {
      "const": "CEML"
    },
    "schema_version": {
      "const": "CEML-RUN-MANIFEST-1"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "protocol_version": {
      "const": "CEML-SCI-1"
    },
    "protocol_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "rung": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_version",
        "decimal_digits",
        "rung_index"
      ],
      "properties": {
        "definition_version": {
          "const": "decimal-digits-v1"
        },
        "decimal_digits": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "rung_index": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "primitive",
        "seed_commitment",
        "seed_hex",
        "retry",
        "start_digest",
        "start_bit_length",
        "start_decimal_digits"
      ],
      "properties": {
        "version": {
          "const": "ceml-start-v1"
        },
        "primitive": {
          "const": "SHAKE256-FIPS202-2015"
        },
        "seed_commitment": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "seed_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retry": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "start_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "start_bit_length": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "start_decimal_digits": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "map_semantics_version": {
      "const": "CEML-COLLATZ-1"
    },
    "exact_arithmetic": {
      "const": true
    },
    "engine_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "build_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "machine_profile_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validation_evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checkpoint_format_version": {
      "const": "CEML-CKPT-1"
    },
    "authorization_gate": {
      "const": "E1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
