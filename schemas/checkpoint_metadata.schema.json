{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jfairfaxball-348/CEML/schemas/checkpoint_metadata.schema.json",
  "title": "CEML Checkpoint Metadata",
  "description": "R3-frozen metadata for CEML-CKPT-1.",
  "x-ceml-status": "frozen-scientific-r3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint_format_version",
    "metadata_digest",
    "run_id",
    "sequence",
    "previous_metadata_digest",
    "manifest_digest",
    "original_start_digest",
    "protocol_version",
    "protocol_commit",
    "engine_commit",
    "build_digest",
    "machine_profile_digest",
    "validation_evidence_digest",
    "map_semantics_version",
    "body_bytes",
    "body_digest",
    "current_value_digest",
    "shortcut_steps",
    "odd_steps",
    "standard_steps",
    "terminal_reached"
  ],
  "properties": {
    "schema_version": {
      "const": "CEML-CHECKPOINT-METADATA-1"
    },
    "checkpoint_format_version": {
      "const": "CEML-CKPT-1"
    },
    "metadata_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "previous_metadata_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "original_start_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "protocol_version": {
      "const": "CEML-SCI-1"
    },
    "protocol_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "engine_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "build_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "machine_profile_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validation_evidence_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "map_semantics_version": {
      "const": "CEML-COLLATZ-1"
    },
    "body_bytes": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "body_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "current_value_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "shortcut_steps": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "odd_steps": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "standard_steps": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "terminal_reached": {
      "type": "boolean"
    }
  }
}
